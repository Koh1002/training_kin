# Supabase プロジェクトの Settings > API から取得する。
# 入れるのは anon（publishable）キー。service_role / sb_secret_ キーを入れると
# ブラウザに配信されて RLS が丸ごと迂回されるため、npm run check:setup が検出して止める。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# マジックリンクの戻り先の組み立てに使う。Server Action の中でしか読まないので
# NEXT_PUBLIC_ は付けない（付けると Vercel に「ブラウザへ露出する」と警告される）。
# 未設定ならリクエストのホストから推測するので、ローカル開発では省略してよい。
# 本番では宛先を推測に頼らないよう設定しておくことを勧める。
# SITE_URL=https://your-app.vercel.app
